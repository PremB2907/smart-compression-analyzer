# Copy to .env for local Docker Compose (never commit .env)

# --- Application ---
ENVIRONMENT=development
SECRET_KEY=generate-with-openssl-rand-hex-32
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_USER=securearchive
POSTGRES_PASSWORD=changeme-local-docker-only
POSTGRES_DB=securearchive
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_WORKER_CONCURRENCY=1
CELERY_TASK_TIME_LIMIT_SEC=600

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme-local-docker-only
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
MINIO_BUCKET=securearchive

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
