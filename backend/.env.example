# Backend-only local run (without Docker). For full stack, use repo root .env.example
ENVIRONMENT=development
SECRET_KEY=generate-with-openssl-rand-hex-32
LOG_LEVEL=INFO
DATABASE_URL=postgresql://securearchive:changeme@localhost:5432/securearchive
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme-local-only
MINIO_BUCKET=securearchive
CORS_ORIGINS=http://localhost:3000
